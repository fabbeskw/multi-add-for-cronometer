{
  "manifest_version": 3,
  "name": "Multi-Add for Cronometer",
  "description": "Unofficial, not affiliated: faster Cronometer web diary logging - add a whole list of foods at once and track your adaptive TDEE.",
  "version": "0.3.1",
  "homepage_url": "https://github.com/fabbeskw/multi-add-for-cronometer",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://cronometer.com/*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Multi-Add for Cronometer (open cronometer.com/#diary and press Alt+Shift+M)",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://cronometer.com/*"],
      "js": ["src/hook-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://cronometer.com/*"],
      "js": [
        "src/lib/gwt-registry.js",
        "src/lib/gwt-stream.js",
        "src/lib/registry-builder.js",
        "src/lib/registry-store.js",
        "src/lib/rpc.js",
        "src/lib/capture.js",
        "src/lib/parse.js",
        "src/lib/units.js",
        "src/lib/plan.js",
        "src/lib/dom.js",
        "src/lib/engine-rpc.js",
        "src/lib/engine-ui.js",
        "src/tdee/adaptive-tdee.js",
        "src/tdee/tdee-data.js",
        "src/ui/panel.css.js",
        "src/ui/panel.js",
        "src/ui/tdee-view.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
